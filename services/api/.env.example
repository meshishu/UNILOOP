# Same Supabase project the web app uses. Only PUBLIC values are needed:
# every request runs as the signed-in user, so Postgres RLS stays the
# authorization boundary. NEVER put a service_role key in this service.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

PORT=4000
HOST=0.0.0.0
NODE_ENV=production
# Comma-separated browser origins allowed by CORS. Empty = no browser origins.
CORS_ORIGINS=
# Set to the number of reverse-proxy hops (e.g. 1 on Fly/Railway/Render) so
# rate limits see the real client IP. Leave 0 when exposed directly.
TRUST_PROXY_HOPS=0
# Requests per minute per IP (global) and for the email-login endpoints.
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# Mutation gates mirror apps/web. Keep false until hosted verification passes.
ENABLE_MARKETPLACE_WRITES=false
ENABLE_MARKETPLACE_INTERACTIONS=false
ENABLE_MARKETPLACE_USER_ACTIONS=false
ENABLE_RENTAL_OPERATIONS=false
ENABLE_SALE_TRANSACTIONS=false
